# ✅ .env.example - VARIABLES D'ENTORN (NO COMETRE .env REAL!)

# === SUPABASE ===
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# === API KEYS (GESTIONAR DES DE BACKEND) ===
# NOTA: Les claus API de Gemini NO van al frontend
# VITE_GEMINI_API_KEY=només per a desenvolupament local

# === ENVIRONMENT ===
VITE_APP_ENV=development  # development, staging, production

# === MONITORING ===
VITE_SENTRY_DSN=  # Optional: Sentry DSN per a producció
VITE_GA4_ID=  # Optional: Google Analytics 4 ID

# === FEATURES ===
VITE_ENABLE_MOCKS=false
VITE_ENABLE_DEBUG=false

# === BUILD ===
VITE_APP_VERSION=10.33.16-BATEGA
