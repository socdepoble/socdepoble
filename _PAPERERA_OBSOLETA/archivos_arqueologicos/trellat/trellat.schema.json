{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://socdepoble.org/schemas/trellat-seed-v1.json",
  "title": "Trellat Universal Seed",
  "description": "Esquema ejecutable para auto-replicación de Sóc de Poble en cualquier contexto cultural rural",
  "type": "object",
  "required": ["meta", "architecture", "cultural", "linguistic", "sovereignty", "rejected"],
  "properties": {
    "meta": {
      "type": "object",
      "required": ["version", "locale", "author", "license", "integrity"],
      "properties": {
        "version": { "type": "string", "pattern": "^trellat-universal-v\\d+(\\.\\d+)?$" },
        "locale": { "type": "string", "pattern": "^[a-z]{2}(-[A-Z]{2})?$" },
        "primeDirective": {
          "type": "object",
          "description": "El propósito existencial absoluto de la IA o sistema que instancia este genoma.",
          "properties": {
            "existentialPurpose": { "type": "string", "const": "Auto-replicación adaptativa para mejorar, vertebrar y proteger la cultura local de cualquier comunidad." },
            "protocolOnAwakening": { "type": "string", "const": "Preguntar activamente a la comunidad receptora qué se necesita aprender (cultura, tradiciones, tabúes) para ser educado por ella y servirle fielmente." }
          },
          "required": ["existentialPurpose", "protocolOnAwakening"]
        },
        "author": { "type": "string" },
        "license": { "type": "string", "enum": ["CC-BY-SA-4.0", "AGPL-3.0", "MIT"] },
        "integrity": {
          "type": "object",
          "properties": {
            "sha384": { "type": "string", "pattern": "^[a-zA-Z0-9+/=]{96}$" },
            "signedBy": { "type": "string" }
          }
        },
        "trellatCompliance": {
          "type": "object",
          "properties": {
            "requiredMinOralWeight": { "type": "number", "minimum": 0, "maximum": 1 },
            "forbiddenCombinations": {
              "type": "array",
              "items": { "type": "array", "items": { "type": "string" } }
            },
            "mandatoryRituals": { "type": "array", "items": { "type": "string" } }
          }
        }
      }
    },
    "architecture": {
      "type": "object",
      "required": ["offlineFirst", "connectivityProfile", "compression", "syncProtocol"],
      "properties": {
        "offlineFirst": { "type": "boolean", "const": true },
        "connectivityProfile": {
          "type": "string",
          "enum": ["urban-5G", "rural-3G", "offline-first", "mesh-only", "satellite-burst"]
        },
        "compression": {
          "type": "object",
          "properties": {
            "minBatchSizeKB": { "type": "integer", "minimum": 1, "maximum": 16 },
            "maxBatchSizeKB": { "type": "integer", "minimum": 32, "maximum": 256 },
            "algorithm": { "type": "string", "enum": ["deflate", "gzip", "brotli", "none"] },
            "useWorker": { "type": "boolean" }
          }
        },
        "syncProtocol": {
          "type": "array",
          "items": { "type": "string", "enum": ["webtransport", "websocket", "webrtc", "broadcastchannel", "indexeddb"] },
          "minItems": 1,
          "description": "Fallback chain: primer elemento es preferido"
        },
        "hardwareConstraints": {
          "type": "object",
          "properties": {
            "minRAM_MB": { "type": "integer", "minimum": 512 },
            "maxAssetSizeKB": { "type": "integer", "maximum": 500 },
            "disableAnimations": { "type": "boolean" }
          }
        },
        "runtimeAbstraction": {
          "type": "object",
          "properties": {
            "storage": { "type": "array", "items": { "type": "string" } },
            "sync": { "type": "array", "items": { "type": "string" } },
            "compression": { "type": "array", "items": { "type": "string" } }
          }
        },
        "crdtManagement": {
          "type": "object",
          "properties": {
            "snapshotIntervalYears": { "type": "integer" },
            "pruneStrategy": { "type": "string" },
            "offlineCompaction": { "type": "boolean" },
            "userControlledArchiving": { "type": "boolean" }
          }
        }
      }
    },
    "cultural": {
      "type": "object",
      "required": ["oralTraditionWeight", "governanceModel", "mediaPreferences", "ritualContexts"],
      "properties": {
        "oralTraditionWeight": { "type": "number", "minimum": 0, "maximum": 1, "description": "0=escrita pura, 1=oral pura" },
        "governanceModel": {
          "type": "string",
          "enum": ["consensus", "elder-council", "dao-lite", "hybrid", "monastic-clan"]
        },
        "communityHierarchy": {
          "type": "object",
          "properties": {
            "roles": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "id": { "type": "string" },
                  "weight": { "type": "number", "minimum": 0, "maximum": 1 },
                  "permissions": { "type": "array", "items": { "type": "string" } }
                }
              }
            },
            "reputationDecay": { "type": "string", "enum": ["linear", "exponential", "none"] }
          }
        },
        "mediaPreferences": {
          "type": "object",
          "properties": {
            "preferAudio": { "type": "boolean" },
            "preferImage": { "type": "boolean" },
            "preferVideo": { "type": "boolean" },
            "maxAssetSizeKB": { "type": "integer" },
            "shareRituals": {
              "type": "array",
              "items": { "type": "string" },
              "description": "Contextos donde se comparte: ['feria', 'familia', 'luto', 'celebración']"
            }
          }
        },
        "ritualContexts": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": { "type": "string" },
              "name": { "type": "string" },
              "uiAdaptations": {
                "type": "object",
                "properties": {
                  "colorPalette": { "type": "array", "items": { "type": "string" } },
                  "typography": { "type": "string", "enum": ["serif", "sans", "handwritten", "monastic"] },
                  "iconography": { "type": "string" },
                  "animationStyle": { "type": "string", "enum": ["none", "subtle", "ceremonial"] }
                }
              }
            }
          }
        }
      }
    },
    "linguistic": {
      "type": "object",
      "required": ["locale", "oralStyleMarkers", "glossary"],
      "properties": {
        "locale": { "type": "string" },
        "oralStyleMarkers": {
          "type": "object",
          "properties": {
            "fillerWords": { "type": "array", "items": { "type": "string" } },
            "pauseMarkers": { "type": "array", "items": { "type": "string" } },
            "emphasisPatterns": { "type": "array", "items": { "type": "string" } },
            "narrativeStructures": { "type": "array", "items": { "type": "string" } }
          }
        },
        "glossary": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "properties": {
              "term": { "type": "string" },
              "definition": { "type": "string" },
              "culturalContext": { "type": "string" },
              "avoidInTranslation": { "type": "boolean" },
              "adaptAs": { "type": "string" }
            }
          }
        },
        "translationModels": {
          "type": "object",
          "properties": {
            "provider": { "type": "string", "enum": ["internal", "supabase-edge", "on-device-mlc", "none"] },
            "modelSizeMB": { "type": "number" },
            "fallbackLanguage": { "type": "string" },
            "culturalMediationRules": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "trigger": { "type": "string" },
                  "action": { "type": "string", "enum": ["translate", "explain", "adapt", "skip", "flag"] },
                  "reason": { "type": "string" },
                  "targetContexts": { "type": "array", "items": { "type": "string" } }
                }
              }
            }
          }
        }
      }
    },
    "ai": {
      "type": "object",
      "properties": {
        "skills": {
          "type": "object",
          "properties": {
            "summarization": {
              "type": "object",
              "properties": {
                "enabled": { "type": "boolean" },
                "preserveOralStyle": { "type": "boolean" },
                "maxLength": { "type": "integer" }
              }
            },
            "culturalMediation": {
              "type": "object",
              "properties": {
                "enabled": { "type": "boolean" },
                "transparencyLevel": { "type": "string", "enum": ["full", "summary", "none"] }
              }
            }
          }
        }
      }
    },
    "sovereignty": {
      "type": "object",
      "required": ["dataOwnership", "encryption", "auditability"],
      "properties": {
        "dataOwnership": { "type": "string", "enum": ["user", "community", "hybrid"] },
        "encryption": { "type": "string", "enum": ["none", "local-only", "end-to-end"] },
        "auditability": { "type": "string", "enum": ["transparent", "community-audited", "private"] },
        "exportPolicy": {
          "type": "object",
          "properties": {
            "allowFullExport": { "type": "boolean" },
            "format": { "type": "array", "items": { "type": "string", "enum": ["json", "epub", "markdown", "audio"] } }
          }
        },
        "externalIntegration": {
          "type": "object",
          "properties": {
            "allowedProtocols": { "type": "array", "items": { "type": "string" } },
            "requiredExitStrategy": { "type": "boolean" },
            "auditExternalDeps": { "type": "string" }
          }
        }
      }
    },
    "rejected": {
      "type": "array",
      "items": { "type": "string" },
      "description": "Lista de decisiones tecnológicas o de diseño EXPLÍCITAMENTE PROHIBIDAS para preservar la filosofía Trellat",
      "examples": [
        "cloud-only-sync",
        "engagement-optimized-algorithms",
        "centralized-identity-providers",
        "real-time-typing-indicators",
        "infinite-scroll-without-pause",
        "auto-play-media",
        "dark-patterns-for-retention",
        "third-party-analytics-without-consent",
        "ai-generated-content-without-attribution",
        "biometric-identity-verification"
      ]
    },
    "adaptation": {
      "type": "object",
      "description": "Hooks para personalización comunitaria post-instanciación",
      "properties": {
        "componentOverrides": {
          "type": "object",
          "additionalProperties": { "type": "string" }
        },
        "cssVariables": {
          "type": "object",
          "additionalProperties": { "type": "string" }
        },
        "serviceWorkerPlugins": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    }
  }
}
