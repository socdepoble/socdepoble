    "postcss": "^8.5.6",
    "puppeteer-core": "^25.1.0",
    "rollup-plugin-visualizer": "^7.0.1",
    "tailwindcss": "^4.1.18",
    "ts-morph": "^21.0.1",
    "tsx": "^4.21.0",
    "vite": "^7.2.4",
    "vite-plugin-static-copy": "^0.12.0",
    "vitest": "^4.1.0",
    "workbox-core": "^7.4.0",
    "workbox-precaching": "^7.4.0"
  },
  "build": {
    "appId": "org.socdepoble.app",
    "productName": "Sóc de Poble",
    "directories": {
      "output": "dist-desktop"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "mac": {
      "category": "public.app-category.productivity",
      "target": [
        "dmg"
      ]
    },
    "win": {
      "target": [
        "nsis"
      ]
    },
    "linux": {
      "target": [
        "AppImage"
      ]
    }
  }
}
