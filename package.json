{
  "name": "soc-de-poble-app",
  "private": true,
  "version": "10.41.0",
  "type": "module",
  "main": "electron/main.js",
  "scripts": {
    "codemod:div-title-subtitle": "npx jscodeshift -t scripts/transform-div-title-subtitle.js src",
    "codemod:div-title-subtitle:dry": "npx jscodeshift -t scripts/transform-div-title-subtitle.js src --dry -d -p",
    "codemod:div-media-actions": "npx jscodeshift -t scripts/transform-div-media-actions.js src",
    "codemod:div-media-actions:dry": "npx jscodeshift -t scripts/transform-div-media-actions.js src --dry -d -p",
    "lint:div-soup": "node ./src/scripts/find-div-soup.js",
    "electron:dev": "NODE_ENV=development electron .",
    "electron:build": "npm run build && electron-builder",
    "acta": "node scripts/acta.js",
    "acta:auto": "node scripts/acta.js --auto",
    "rag:index": "node scripts/rag-rural.js index",
    "rag:search": "node scripts/rag-rural.js search",
    "dev": "npm run build:codex && node _scripts/_build_and_deploy/generate_skills_md.js && vite & npm run watch:codex",
    "build": "vite build && npm run copy-wasm && node _scripts/_build_and_deploy/build-health-check.js",
    "build:worker": "esbuild src/workers/rhizome-worker.js --bundle --platform=browser --target=es2020 --outfile=dist/workers/rhizome-worker.js --minify",
    "copy:libs": "mkdir -p dist/libs && cp -a public/libs/* dist/libs/ || true",
    "prepare:worker": "npm run build:worker && npm run copy:libs",
    "clean:dist": "rm -rf dist && mkdir -p dist",
    "copy-wasm": "mkdir -p dist/assets && cp node_modules/@sqlite.org/sqlite-wasm/dist/sqlite3.wasm dist/assets/sqlite3.wasm || copy node_modules\\@sqlite.org\\sqlite-wasm\\dist\\sqlite3.wasm dist\\assets\\sqlite3.wasm",
    "deploy:ftp": "npm run build && node _scripts/_build_and_deploy/deploy.js",
    "deploy": "npm run build && npx firebase-tools deploy --only hosting",
    "lint": "eslint . --ext js,jsx --report-unused-disable-directives --max-warnings 0",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest run --coverage",
    "test:components": "vitest run src/tests/components",
    "test:services": "vitest run src/tests/services",
    "test:contexts": "vitest run src/tests/contexts",
    "preview": "vite preview",
    "deploy:siteground": "bash DEPLOY_SITEGROUND.sh",
    "deploy:brain": "cd google-cloud-backend && gcloud functions deploy marketingBrain --runtime nodejs20 --trigger-http --allow-unauthenticated --region europe-west1",
    "generate:pdf": "node _scripts/_build_and_deploy/generate-pdf.js",
    "build:amazon": "node _scripts/_build_and_deploy/build_amazon_kdp.js",
    "sync:locales": "node _scripts/_build_and_deploy/sync_translations.js",
    "build:codex": "node _scripts/_build_and_deploy/build_amazon_codex.js || true",
    "watch:codex": "node _scripts/_build_and_deploy/build_amazon_codex.js watch",
    "prebuild": "npm run build:codex && node _scripts/_build_and_deploy/generate_skills_md.js",
    "pull:codex": "node _scripts/_build_and_deploy/pull_codex.js",
    "push:codex": "node _scripts/_build_and_deploy/push_codex.js",
    "asiatic-audit": "node _scripts/_maintenance/asiatic_auditor.mjs",
    "vibe-audit": "node _scripts/_maintenance/vibe_auditor.mjs",
    "knip": "knip",
    "depcruise": "depcruise src --config .dependency-cruiser.js",
    "sync:towns": "node _scripts/_maintenance/sync_town_folders.js",
    "sync:brain": "node scripts/sync-brain.cjs",
    "sync:version": "node _scripts/_maintenance/sync_version.js",
    "ghost:audit": "node _scripts/_maintenance/ghost-tracker.js",
    "trellat:extract": "node scripts/extract-nodes.mjs",
    "trellat:analyze": "node scripts/analyze-flat.js",
    "trellat:detect-orphans": "node scripts/parsers/detect-alignment-orphans.js",
    "trellat:codemod": "jscodeshift -t tools/codemods/remove-empty-wrappers.js src/",
    "prepare": "husky"
  },
  "dependencies": {
    "@capacitor-community/bluetooth-le": "^8.1.3",
    "@capacitor/android": "^8.0.1",
    "@capacitor/assets": "^3.0.5",
