# Headers d'Aïllament Creuat (COOP/COEP) per a habilitar SharedArrayBuffer i OPFS Async per a SQLite
<IfModule mod_headers.c>
    Header set Cross-Origin-Opener-Policy "same-origin"
    Header set Cross-Origin-Embedder-Policy "credentialless"
</IfModule>

# [MASTER PROTOCOL] Obligatory MIME Types for PowerSync / SQLite WASM
<IfModule mod_mime.c>
    AddType application/wasm .wasm
</IfModule>

# Ruteig SPA (React Router)
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Forçar HTTPS i domini canònic (socdepoble.org) per evitar errors SSL en dominis secundaris
  RewriteCond %{HTTP_HOST} !=localhost
  RewriteCond %{HTTP_HOST} !=127.0.0.1
  RewriteCond %{HTTPS} off [OR]
  RewriteCond %{HTTP_HOST} !^socdepoble\.org$ [NC]
  RewriteRule ^(.*)$ https://socdepoble.org/$1 [L,R=301]

  RewriteRule ^index\.html$ - [L]
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule . /index.html [L]
</IfModule>
