<IfModule mod_headers.c>
  # 1. Headers crìtics per a l'App i Seguretat (Evitar error COEP/COOP a consola)
  Header set Cross-Origin-Opener-Policy "same-origin"
  Header set Cross-Origin-Embedder-Policy "credentialless"

  # 2. Desactivar COMPLETAMENT la caché per a l'HTML i el Service Worker
  <FilesMatch "^(index\.html|sw\.js)$">
    Header set Cache-Control "no-store, no-cache, must-revalidate, proxy-revalidate, max-age=0"
    Header set Pragma "no-cache"
    Header set Expires "0"
  </FilesMatch>

  # 3. Caché agressiu per als assets compilats amb hash (imatges, js, css, woff)
  <FilesMatch "\.(css|js|woff2?|png|jpe?g|gif|webp|ico|svg)$">
    # Si és un manifest PWA, no ho trastejar:
    <If "%{REQUEST_URI} !~ m#/site\.webmanifest$#">
      Header set Cache-Control "public, max-age=31536000, immutable"
    </If>
  </FilesMatch>
</IfModule>

# 4. Routing de Single Page App (React/Vite)
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /
  RewriteRule ^index\.html$ - [L]
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule . /index.html [L]
</IfModule>
