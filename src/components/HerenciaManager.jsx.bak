import React, { useState, useEffect } from "react";
import {
  Shield,
  Upload,
  FileText,
  CheckCircle2,
  AlertCircle,
  X,
  Sparkles,
  Brain,
  ArrowLeft,
  Landmark,
  Calculator,
  Calendar,
  Trash2,
  Eye,
  Camera,
  MessageSquare,
  Terminal,
} from "lucide-react";
import MediaViewerModal from "./MediaViewerModal";
import IAIAChatSidebar from "./IAIAChatSidebar";
import "./HerenciaManager.css";

/**
 * HerenciaManager [MASTER ALZINA]
 * Gestor sobirà per al protocol d'herència i successions.
 * Ofereix trellat sobre deutes, documents i passos a seguir.
 */
const HerenciaManager = ({ onBack }) => {
  const [docs, setDocs] = useState(() => {
    const saved = localStorage.getItem("herencia_docs");
    return saved ? JSON.parse(saved) : [
      {
        id: 1,
        name: "Rebut_SUMA_2025_028468.pdf",
        status: "validat",
        type: "Liquidació",
        date: "16/02/2026",
        src: "/assets/demo/rebut_suma_sample.pdf"
      },
    ];
  });

  const [isAnalyzing, setIsAnalyzing] = useState(false);
  const [isChatOpen, setIsChatOpen] = useState(false);
  const [viewerData, setViewerData] = useState({ isOpen: false, src: "", title: "", type: "" });

  useEffect(() => {
    localStorage.setItem("herencia_docs", JSON.stringify(docs));
  }, [docs]);

  const debtData = [
    { concepto: "Aigües Potables", ubicacion: "San Isidro, 16", total: 47.4, quota: 23.7 },
    { concepto: "Aigües Potables", ubicacion: "Barrinada, 4", total: 31.48, quota: 15.74 },
    { concepto: "Aigua i Clavegueram", ubicacion: "San Isidro, 16", total: 41.86, quota: 20.93 },
    { concepto: "Aigua i Clavegueram", ubicacion: "Barrinada, 4", total: 99.95, quota: 49.97 },
  ];

  const totalDebt = debtData.reduce((acc, curr) => acc + curr.total, 0);
  const totalQuota = debtData.reduce((acc, curr) => acc + curr.quota, 0);

  const phases = [
    {
      id: 1,
      title: "Pagament SUMA",
      status: "current",
      desc: "Liquidació de 226,69€ (Apremi). Límit: 03/03/2026.",
    },
    {
      id: 2,
      title: "Canvi Titularitat",
      status: "pending",
      desc: "Gestió amb Proaguas Costa Blanca.",
    },
    {
      id: 3,
      title: "Regularització",
      status: "pending",
      desc: "Actualització de padró a SUMA Sant Joan.",
    },
  ];

  const handleUpload = async (e) => {
    const file = e.target.files[0];
    if (!file) return;
    setIsAnalyzing(true);

    try {
      let imageData = null;
      if (file.type.startsWith('image/')) {
        const reader = new FileReader();
        const base64Promise = new Promise((resolve) => {
          reader.onload = (e) => resolve(e.target.result.split(',')[1]);
          reader.readAsDataURL(file);
        });
        const base64 = await base64Promise;
        imageData = { mimeType: file.type, data: base64 };
      }

      let iaiaComment = "";
      if (imageData) {
        const { geminiService } = await import('../services/geminiService');
        const response = await geminiService.ask('ULL_IAIA', "Mestre, analitza aquest document d'herència per a mi. Digues-me què veus i com afecta al protocol de l'Herminio.", imageData);
        iaiaComment = response.text;
      }

      const newDoc = {
        id: Date.now(),
        name: file.name,
        status: "pendent",
        type: file.type.startsWith('image/') ? "Foto / Escaneig" : (file.type.startsWith('video/') ? "Vídeo Protocol" : "Document Herència"),
        fileType: file.type, // BATEGAT: Guardem el tipus real per al renderitzador
        date: new Date().toLocaleDateString(),
        src: URL.createObjectURL(file),
        analysis: iaiaComment
      };
      
      setDocs((prev) => [...prev, newDoc]);
    } catch (err) {
      console.error("Error analitzant document:", err);
    } finally {
      setIsAnalyzing(false);
    }
  };

  const removeDoc = (id) => {
    setDocs(prev => prev.filter(d => d.id !== id));
  };

  const generateReport = () => {
    const report = `
# INFORME D'EXPEDAT: HERÈNCIA HERMINIO [BATEGAT]
Data: ${new Date().toLocaleDateString()}
Expedient SUMA: 24-2025-028468

## 1. DOCUMENTS EN DIPÒSIT
${docs.map(d => `- ${d.name} (${d.type}) [${d.status.toUpperCase()}]`).join('\n')}

## 2. ANÀLISI DE L'IAIA
${totalDebt.toFixed(2)}€ de deute total detectat.
Protocol actiu fins al 03/03/2026.

## 3. LOG D'EXECUCIÓ ARCHON
- [OK] Verificació de deute SUMA.
- [OK] Bategat multimèdia de documents.
- [PENDENT] Canvi de titularitat Proaguas.

INFORME GENERAT PER ARCHON PROTOCOL.
    `;
    const blob = new Blob([report], { type: 'text/markdown' });
    const url = URL.createObjectURL(blob);
    const link = document.createElement('a');
    link.href = url;
    link.download = `INFORME_EXPEDAT_HERMINIO_${Date.now()}.md`;
    link.click();
  };

  return (
    <div className="herencia-manager animate-in">
      <header className="herencia-header-master">
        <button className="btn-back-ofici" onClick={onBack}>
          <ArrowLeft size={20} />
        </button>
        <div className="herencia-title-group">
          <h1>Protocol Herència: Herminio</h1>
          <p>Expedient SUMA: 24-2025-028468</p>
        </div>
        <div className="herencia-status-badge animate-pulse">
          PROTOCOL ACTIU (APREMI)
        </div>
        <button 
          className="p-3 bg-fuchsia-600 rounded-full hover:scale-110 transition-transform shadow-lg shadow-fuchsia-500/20"
          onClick={() => setIsChatOpen(true)}
        >
          <MessageSquare size={20} />
        </button>
      </header>

      <div className="herencia-grid-layout">
        {/* 1. Quadre de Deutes (Taula de Trellat) */}
        <section className="herencia-section debt-section glass-premium">
          <div className="section-header">
            <Calculator size={22} className="text-fuchsia-500" />
            <h2>El Compte del Mas (SUMA)</h2>
          </div>

          <div className="debt-table-wrapper">
            <table className="debt-table">
              <thead>
                <tr>
                  <th>Concepte</th>
                  <th>Ubicació</th>
                  <th className="text-right">Total</th>
                  <th className="text-right">La teua part (50%)</th>
                </tr>
              </thead>
              <tbody>
                {debtData.map((item, idx) => (
                  <tr key={idx}>
                    <td>{item.concepto}</td>
                    <td>{item.ubicacion}</td>
                    <td className="text-right">{item.total.toFixed(2)}€</td>
                    <td className="text-right font-bold text-fuchsia-400">{item.quota.toFixed(2)}€</td>
                  </tr>
                ))}
              </tbody>
              <tfoot>
                <tr className="total-row">
                  <td colSpan="2">TOTAL A PAGAR</td>
                  <td className="text-right">{totalDebt.toFixed(2)}€</td>
                  <td className="text-right text-xl font-black text-fuchsia-500">{totalQuota.toFixed(2)}€</td>
                </tr>
              </tfoot>
            </table>
          </div>

          <div className="urgent-notice bg-red-950/20 border border-red-500/30 p-4 rounded-2xl flex gap-3 items-center">
            <AlertCircle className="text-red-500" size={20} />
            <p className="text-xs text-red-200/80 uppercase font-black tracking-widest">
                LÍMIT DE PAGAMENT: 03/03/2026
            </p>
          </div>
        </section>

        {/* 2. El Tauler de l'IAIA (Anàlisi i Consells) */}
        <section className="herencia-section iaia-analysis-section glass-premium">
          <div className="section-header">
            <Brain size={22} className="text-fuchsia-400" />
            <h2>L'Ull de la IAIA</h2>
          </div>
          <div className="iaia-advice-box fuchsia">
            <p>
              "Mestre, les aigües de San Isidro i Barrinada no bateguen gratis. He calculat que el deute de l'Herminio ha pujat per l'apremi ({totalDebt.toFixed(2)}€). El meu trellat diu: pagueu-ho ja a la web de SUMA per aturar els interessos, i després anirem a Proaguas amb les escriptures."
            </p>
            <div className="advice-tags">
              <span className="tag-k fuchsia">EXP: 028468</span>
              <span className="tag-k fuchsia">WEB SUMA: OBLIGATORI</span>
            </div>
          </div>

          <div className="herencia-phases-tracking">
            {phases.map((p) => (
              <div key={p.id} className={`phase-item ${p.status}`}>
                <div className="phase-dot"></div>
                <div className="phase-text">
                  <strong>{p.title}</strong>
                  <span>{p.desc}</span>
                </div>
              </div>
            ))}
          </div>
        </section>

        {/* 3. Dipòsit de Documents */}
        <section className="herencia-section vault-section glass-premium">
           <div className="section-header">
                <Shield size={22} className="text-accent" />
                <h2>Dipòsit Notarial (The Vault)</h2>
            </div>

            <div className="docs-list-kit">
            {docs.map((doc) => (
              <div 
                key={doc.id} 
                className={`doc-kit-item ${doc.status} animate-in slide-in-from-right-4 cursor-pointer hover:bg-white/5 transition-colors`}
                onClick={() => setViewerData({ isOpen: true, src: doc.src, title: doc.name, type: doc.fileType })}
              >
                <div className="flex items-center gap-4 flex-1">
                    <FileText size={20} className="text-fuchsia-400" />
                    <div className="doc-kit-info">
                        <span className="doc-name">{doc.name}</span>
                        <span className="doc-meta">
                            {doc.type} • {doc.date}
                        </span>
                    </div>
                </div>
                <div className="doc-kit-actions flex items-center gap-2">
                  <CheckCircle2 size={16} className="text-green-500" />
                  {doc.id > 1 && (
                    <span className="bg-fuchsia-500 text-[8px] px-1.5 py-0.5 rounded-full font-black animate-pulse">NOU</span>
                  )}
                  <button 
                    className="p-1 hover:text-red-500 transition-colors"
                    onClick={(e) => { e.stopPropagation(); removeDoc(doc.id); }}
                  >
                    <Trash2 size={14} />
                  </button>
                </div>
              </div>
            ))}
          </div>

          <div className="multimedia-actions-grid grid grid-cols-2 gap-4">
            <label className="btn-kit-upload fuchsia flex-col pt-6 pb-6">
              <input 
                  type="file" 
                  hidden 
                  onChange={handleUpload} 
                  onClick={(e) => e.target.value = null}
                  accept="application/pdf,.doc,.docx"
              />
              <Upload size={24} className={isAnalyzing ? "animate-bounce" : ""} />
              <span className="text-[10px] mt-2">Pujar Document</span>
            </label>

            <label className="btn-kit-upload accent flex-col pt-6 pb-6">
              <input 
                  type="file" 
                  hidden 
                  capture="environment"
                  onChange={handleUpload} 
                  onClick={(e) => e.target.value = null}
                  accept="image/*,video/*"
              />
              <Camera size={24} className={isAnalyzing ? "animate-pulse" : ""} />
              <span className="text-[10px] mt-2">Fer Foto o Vídeo</span>
            </label>
          </div>

          {isAnalyzing && (
            <div className="analyzing-status flex items-center justify-center gap-3 p-4 bg-fuchsia-500/10 rounded-2xl border border-fuchsia-500/20">
              <Sparkles className="animate-spin text-fuchsia-400" size={16} />
              <span className="text-[10px] font-black uppercase tracking-widest text-fuchsia-400">
                L'Ull de la IAIA està bategant el document...
              </span>
            </div>
          )}
        </section>
      </div>

      <footer className="herencia-footer-master flex justify-between items-center">
        <div className="sovereign-badge flex items-center gap-2">
          <Shield size={14} />{" "}
          <span>Assisència bategada pel Protocol Rhizome 🏺</span>
        </div>
        <button 
          className="btn-report-final master-button-canonic px-6 py-2 bg-white/5 border border-white/10 hover:bg-white/10 transition-colors uppercase font-black text-[10px] tracking-widest rounded-full"
          onClick={generateReport}
        >
          Generar Informe Final
        </button>
      </footer>

      {viewerData.isOpen && (
        <div className="herencia-analysis-overlay animate-in" onClick={() => setViewerData({ ...viewerData, isOpen: false })}>
            <div className="herencia-analysis-modal glass-premium" onClick={e => e.stopPropagation()}>
                <header className="flex justify-between items-center mb-6">
                    <h2 className="text-xl font-black uppercase text-fuchsia-400">Anàlisi de l'Ull de la IAIA</h2>
                    <button onClick={() => setViewerData({ ...viewerData, isOpen: false })}><X /></button>
                </header>
                
                <div className="analysis-content grid grid-cols-1 md:grid-cols-2 gap-8">
                    <div className="media-preview-box rounded-2xl overflow-hidden bg-black border border-white/5">
                        {viewerData.type?.includes('video') ? (
                            <video src={viewerData.src} controls className="w-full h-full object-contain" />
                        ) : (
                            <img src={viewerData.src} alt="" className="w-full h-full object-contain" />
                        )}
                    </div>
                    <div className="iaia-commentary-box">
                        <div className="flex items-center gap-3 mb-4">
                            <Brain size={24} className="text-fuchsia-400" />
                            <h3 className="font-bold text-lg">Veredicte Bategat</h3>
                        </div>
                        <p className="text-gray-300 leading-relaxed italic">
                            "{docs.find(d => d.src === viewerData.src)?.analysis || "Encara no he bategat aquest document, mestre. Deixa'm un moment..."}"
                        </p>
                        
                        <div className="mt-8 flex gap-4">
                            <button className="flex-1 master-button-canonic bg-fuchsia-600" onClick={() => setViewerData({ ...viewerData, isOpen: false })}>
                                ENTÈS!
                            </button>
                            <button className="px-6 border border-white/10 rounded-full" onClick={() => window.open(viewerData.src)}>
                                <Eye size={18} />
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        </div>
      )}

      <MediaViewerModal 
        isOpen={viewerData.isOpen && !docs.find(d => d.src === viewerData.src)?.analysis}
        onClose={() => setViewerData({ ...viewerData, isOpen: false })}
        src={viewerData.src}
        title={viewerData.title}
        type="pdf"
      />

      <IAIAChatSidebar 
        isOpen={isChatOpen} 
        onClose={() => setIsChatOpen(false)} 
        context="herencia_herminio"
      />
    </div>
  );
};

export default HerenciaManager;
