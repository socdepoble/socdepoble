{
    "rewrites": [
        {
            "source": "/rescat.html",
            "destination": "/rescat.html"
        },
        {
            "source": "/rescue.html",
            "destination": "/rescue.html"
        },
        {
            "source": "/_nuke.html",
            "destination": "/_nuke.html"
        },
        {
            "source": "/((?!rescat.html|rescue.html|_nuke.html|api/|tools/).*)",
            "destination": "/index.html"
        }
    ],
    "headers": [
        {
            "source": "/index.html",
            "headers": [
                {
                    "key": "Cache-Control",
                    "value": "public, max-age=0, must-revalidate"
                }
            ]
        },
        {
            "source": "/tools/(.*)",
            "headers": [
                {
                    "key": "Clear-Site-Data",
                    "value": "\"*\""
                },
                {
                    "key": "Cache-Control",
                    "value": "no-store, no-cache, must-revalidate, proxy-revalidate"
                }
            ]
        }
    ]
}