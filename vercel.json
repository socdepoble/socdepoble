{
    "redirects": [
        {
            "source": "/rescat",
            "destination": "/rescat.html",
            "permanent": false
        },
        {
            "source": "/nuke",
            "destination": "/_nuke.html",
            "permanent": false
        }
    ],
    "rewrites": [
        {
            "source": "/rescat.html",
            "destination": "/rescat.html"
        },
        {
            "source": "/rescue.html",
            "destination": "/rescue.html"
        },
        {
            "source": "/_nuke.html",
            "destination": "/_nuke.html"
        },
        {
            "source": "/sw.js",
            "destination": "/sw.js"
        },
        {
            "source": "/api/:path*",
            "destination": "/api/:path*"
        },
        {
            "source": "/((?!rescat.html|rescue.html|_nuke.html|sw.js|api/|check.txt|.*\\.(png|jpg|ico|svg|json|txt|webp)).*)",
            "destination": "/index.html"
        }
    ],
    "headers": [
        {
            "source": "/(rescat.html|rescue.html|_nuke.html)",
            "headers": [
                {
                    "key": "Clear-Site-Data",
                    "value": "\"*\""
                },
                {
                    "key": "Cache-Control",
                    "value": "no-store, no-cache, must-revalidate, proxy-revalidate"
                }
            ]
        },
        {
            "source": "/index.html",
            "headers": [
                {
                    "key": "Cache-Control",
                    "value": "public, max-age=0, must-revalidate"
                }
            ]
        },
        {
            "source": "/tools/(.*)",
            "headers": [
                {
                    "key": "Clear-Site-Data",
                    "value": "\"*\""
                },
                {
                    "key": "Cache-Control",
                    "value": "no-store, no-cache, must-revalidate, proxy-revalidate"
                }
            ]
        },
        {
            "source": "/(.*)",
            "headers": [
                {
                    "key": "Cache-Control",
                    "value": "no-store, no-cache, must-revalidate, proxy-revalidate, max-age=0"
                }
            ]
        }
    ]
}