{
    "redirects": [
        {
            "source": "/rescat",
            "destination": "/rescat.html",
            "permanent": false
        },
        {
            "source": "/nuke",
            "destination": "/_nuke.html",
            "permanent": false
        }
    ],
    "rewrites": [
        {
            "source": "/(rescat.html|rescue.html|_nuke.html|sw.js|check.txt|api/.*)",
            "destination": "/$1"
        },
        {
            "source": "/(.*)",
            "destination": "/index.html"
        }
    ],
    "headers": [
        {
            "source": "/(index.html|sw.js|check.txt)",
            "headers": [
                {
                    "key": "Cache-Control",
                    "value": "no-store, no-cache, must-revalidate, proxy-revalidate, max-age=0"
                },
                {
                    "key": "Clear-Site-Data",
                    "value": "\"*\""
                }
            ]
        },
        {
            "source": "/assets/(.*)",
            "headers": [
                {
                    "key": "Cache-Control",
                    "value": "public, max-age=31536000, immutable"
                }
            ]
        }
    ]
}